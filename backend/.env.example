# ── Required ─────────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── Models (defaults shown) ───────────────────────────────────────────────────
LLM_MODEL=google/gemini-3.1-flash-lite
STT_MODEL=openai/whisper-large-v3-turbo
TTS_MODEL=google/gemini-3.8-flash-lite-tts

# ── TTS voices ────────────────────────────────────────────────────────────────
TTS_VOICE_EXAM=Charon      # IELTS examiner voice
TTS_VOICE_CHAT=Aoede       # Free chat voice
TTS_VOICE_COACH=Kore       # Teacher (Anna) voice

# ── Optional ─────────────────────────────────────────────────────────────────
# LLM_REPORT_MODEL=google/gemini-3.1-flash-lite   # separate model for end-of-session reports
# IELTS_P1_ANSWERS=7   # how many Q&A exchanges for Part 1 (default 7)
# IELTS_P3_ANSWERS=5   # how many Q&A exchanges for Part 3 (default 5)

# ── Local pronunciation model ─────────────────────────────────────────────────
# PRON_DEVICE=cpu          # force CPU (auto-quantises to int8); default: cuda if available
# PRON_FP16=1              # use FP16 on GPU (saves VRAM)
# PRON_MODEL=facebook/wav2vec2-xlsr-53-espeak-cv-ft   # default acoustic model (~1.2 GB)
# PRON_SAVE=0              # disable saving recordings locally
